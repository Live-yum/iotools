<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">#00CFED</item>
  <item name="android:colorBackground">#0E202F</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:windowLightNavigationBar">false</item>
  <item name="android:statusBarColor">#07121D</item>
  <item name="android:navigationBarColor">#0E202F</item>
  <item name="android:windowBackground">#07121D</item>
  <item name="android:textColorPrimary">#E7F1F9</item>
  <item name="android:textColorSecondary">#96ACBE</item>
  <item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">#00767C</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:windowLightNavigationBar">true</item>
  <item name="android:statusBarColor">#F5F8FA</item>
  <item name="android:navigationBarColor">#FFFFFF</item>
  <item name="android:windowActionModeOverlay">true</item>
  <item name="android:windowBackground">#F5F8FA</item>
 </style>
</resources>
